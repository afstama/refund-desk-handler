# Copy this file to .env and fill in the four values. .env is ignored by git: never commit real values.
# `npm run check-env` says whether each value has the right shape (it never prints a value).

# A Neon connection string (the pooled one is fine). Use the dev branch locally.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# The secret Qure signs the webhooks with.
WEBHOOK_SECRET=
# The token for approve and reject, and the password of the approval screen.
APPROVER_TOKEN=
# The Anthropic API key (starts with sk-ant-). Used only when TRIAGE_LIVE is 1.
ANTHROPIC_API_KEY=

# Optional (the defaults are in src/config.ts):
# PORT=3000
# TRIAGE_LIVE=1
# TRIAGE_MODEL=claude-haiku-5-5
# TRIAGE_BUDGET_USD=5
# TRIAGE_PER_MINUTE=45
# TRIAGE_CONCURRENCY=4
